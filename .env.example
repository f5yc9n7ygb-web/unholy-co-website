# =============================================================================
# UNHOLY CO. Environment Variables
# =============================================================================
# 
# IMPORTANT: For Cloudflare Pages deployments, these variables must be set in
# the Cloudflare Dashboard (Settings > Environment Variables), NOT in wrangler.toml!
# See CLOUDFLARE_ENV_SETUP.md for detailed setup instructions.
#
# This file is for LOCAL DEVELOPMENT only. Copy to .env.local and fill in values.
# =============================================================================

# Site Configuration
PUBLIC_SITE_URL=https://theunholy.co
SECURITY_SIGNING_SECRET=replace_with_a_long_random_secret

# -----------------------------------------------------------------------------
# Cloudflare Worker Endpoints (PUBLIC - visible in browser)
# -----------------------------------------------------------------------------
# These are used for form submissions and must be set in Cloudflare Pages dashboard
# for production. For local development, use your local worker endpoint.
#
# Production example: https://unholy-co-website.pages.dev/api/contact
# Local development: http://localhost:8787/api/contact

NEXT_PUBLIC_WORKER_ENDPOINT=https://your-domain.pages.dev/api/contact
NEXT_PUBLIC_WORKER_SUBSCRIBE_ENDPOINT=https://your-domain.pages.dev/api/subscribe
NEXT_PUBLIC_WORKER_ORDER_ENDPOINT=https://your-domain.pages.dev/api/order

# -----------------------------------------------------------------------------
# Razorpay Payment Gateway
# -----------------------------------------------------------------------------
# Public key - safe to expose in browser (prefix with NEXT_PUBLIC_)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_AbCdEf12345678

# Secret key - NEVER expose in browser (server-side only, no NEXT_PUBLIC_ prefix)
# Set this in Cloudflare Workers environment, not in Pages build environment
RAZORPAY_KEY_ID=rzp_test_AbCdEf12345678
RAZORPAY_KEY_SECRET=your_secret_key_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# -----------------------------------------------------------------------------
# Shiprocket Fulfillment (Server-side only)
# -----------------------------------------------------------------------------
# IMPORTANT: Shiprocket support states you should create a dedicated API user in
# Settings > API and use those credentials here, not your main login.

SHIPROCKET_EMAIL=your_shiprocket_api_user_email
SHIPROCKET_PASSWORD=your_shiprocket_api_user_password
SHIPROCKET_CHANNEL_ID=
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPROCKET_WEBHOOK_SECRET=your_shiprocket_webhook_secret

# -----------------------------------------------------------------------------
# Contact notifications
# -----------------------------------------------------------------------------
CONTACT_FORWARD_EMAIL=rituals@theunholy.co,press@theunholy.co

# -----------------------------------------------------------------------------
# Airtable (Server-side only - for worker)
# -----------------------------------------------------------------------------
# These should be set in Cloudflare Workers environment variables
# DO NOT use NEXT_PUBLIC_ prefix for these!

AIRTABLE_BASE_ID=
AIRTABLE_ORDERS_BASE_ID=
AIRTABLE_TABLE_NAME=signups
AIRTABLE_TOKEN=

# -----------------------------------------------------------------------------
# Mailjet Email Service (Server-side only - for worker)
# -----------------------------------------------------------------------------
# These should be set in Cloudflare Workers environment variables
# DO NOT use NEXT_PUBLIC_ prefix for these!

MAILJET_API_KEY=
MAILJET_SECRET=
MAILJET_TEMPLATE_ID=
MAILJET_FROM_EMAIL=noreply@theunholy.co
MAILJET_FROM_NAME=UNHOLY CO.
MAILJET_WELCOME_SUBJECT=Your Damnation Is Served
MAILJET_UNSUB_URL=https://theunholy.co/unsubscribe

# -----------------------------------------------------------------------------
# PostHog Analytics (PUBLIC - visible in browser)
# -----------------------------------------------------------------------------
# Sign up at https://posthog.com → create project → copy API key from Settings
# Host: use https://us.i.posthog.com (US) or https://eu.i.posthog.com (EU)

NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# -----------------------------------------------------------------------------
# Sentry Error Tracking (PUBLIC - DSN is safe to expose)
# -----------------------------------------------------------------------------
# Sign up at https://sentry.io → New Project → Next.js → copy DSN from Settings > Client Keys

NEXT_PUBLIC_SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@oxxxxxxx.ingest.sentry.io/xxxxxxx
