{
  "name": "unholy-co",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "migrate:airtable:supabase": "node scripts/migrate-airtable-to-supabase.mjs",
    "migrate:airtable:supabase:dry-run": "node scripts/migrate-airtable-to-supabase.mjs --dry-run",
    "migrate:airtable-csv:supabase": "node scripts/migrate-airtable-to-supabase.mjs --csv-dir=./airtable-export",
    "migrate:airtable-csv:supabase:dry-run": "node scripts/migrate-airtable-to-supabase.mjs --csv-dir=./airtable-export --dry-run",
    "cf:bundle": "node scripts/create-opennext-config.mjs && next build && node scripts/copy-instrumentation-to-standalone.mjs && opennextjs-cloudflare build --skipNextBuild && node scripts/cf-postbuild.mjs",
    "preview": "wrangler dev --local",
    "deploy": "npm run cf:bundle && npx wrangler pages deploy .open-next"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@sentry/nextjs": "^10.51.0",
    "framer-motion": "^12.38.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.23",
    "lucide-react": "0.460.0",
    "next": "^16.2.4",
    "pdf-lib": "^1.17.1",
    "posthog-js": "^1.372.9",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "three": "^0.183.2",
    "vanta": "^0.5.24"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.19.6",
    "@types/node": "22.5.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.183.1",
    "autoprefixer": "10.4.20",
    "eslint": "9.9.0",
    "eslint-config-next": "^16.2.3",
    "picomatch": "^4.0.4",
    "postcss": "8.5.14",
    "tailwindcss": "3.4.10",
    "typescript": "5.6.2",
    "wrangler": "^4.88.0",
    "zod": "^4.3.6"
  },
  "overrides": {
    "postcss": "8.5.14"
  }
}
